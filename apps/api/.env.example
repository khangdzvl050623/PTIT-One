# Copy to .env; keep real values private. Loaded by scripts/dev-api.ps1 only.
# Existing process variables win; blank values are skipped.
# One NAME=value per line. Quotes are optional; values are always literal.
# Put comments on separate lines. UTF-8; no export, interpolation or multiline.

# Optional HTTP port; application defaults to 8080.
SERVER_PORT=

# Leave blank for the current skeleton. Use central AFTER JDBC/profile setup.
SPRING_PROFILES_ACTIVE=

# CENTRAL connection supplied by T1. Never put credentials in the URL.
PTITONE_DB_URL=
PTITONE_DB_USERNAME=
PTITONE_DB_PASSWORD=

# Future CENTRAL profile defaults migration to false. Enable only deliberately.
PTITONE_MIGRATE_ON_START=
PTITONE_MIGRATION_USERNAME=
PTITONE_MIGRATION_PASSWORD=

# Auth: base64 of >= 32 random bytes. Generate once per machine, never commit:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Required by the central profile.
PTITONE_JWT_SECRET=
# HMAC key for 6-digit codes (email verification, password reset). Same format
# as the JWT secret but a DIFFERENT value. Required by the central profile.
PTITONE_OTP_SECRET=
# true only when served over HTTPS.
PTITONE_COOKIE_SECURE=

# Outgoing mail (Brevo SMTP relay, STARTTLS): activation codes, email
# verification, password reset. Blank HOST or FROM turns mail off; those
# features then answer 503 MAIL_DISABLED. Host smtp-relay.brevo.com, port 587. Username is the SMTP login Brevo shows;
# password is the SMTP key, NOT the Brevo account password.
# FROM must be a sender/domain verified in Brevo, otherwise mail is rejected.
PTITONE_MAIL_HOST=smtp-relay.brevo.com
PTITONE_MAIL_PORT=587
PTITONE_MAIL_USERNAME=
PTITONE_MAIL_PASSWORD=
PTITONE_MAIL_FROM=
PTITONE_MAIL_FROM_NAME=PTIT One
