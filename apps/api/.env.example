# Copy to .env; keep real values private. Loaded by scripts/dev-api.ps1 only.
# Existing process variables win; blank values are skipped.
# One NAME=value per line. Quotes are optional; values are always literal.
# Put comments on separate lines. UTF-8; no export, interpolation or multiline.

# Optional HTTP port; application defaults to 8080.
SERVER_PORT=

# `central` does NOT mean "use the CENTRAL database". It means "turn the
# business beans on" — every controller/service/repository is @Profile("central").
# The name is historical, from when there was only one database.
#
#   blank                 no database at all; UI work only
#   central               business beans + the single Part 1 database
#   central,distributed   the SAME beans, but four nodes routed by campus.
#                         CENTRAL is not connected at all in this mode:
#                         our DataSource bean makes Spring Boot's
#                         auto-configured one back off entirely.
#
# Order does not matter; see RoutingProfileOrderTest.
SPRING_PROFILES_ACTIVE=

# --- Profile `central` only: the single Part 1 database ---------------------
# Still needed even after Part 2 works: it is how you run the Part 1 demo,
# and CENTRAL stays the source that db/migrate reads from.
# Ignored when the active profiles are `central,distributed`.
# Never put credentials in the URL.
PTITONE_DB_URL=
PTITONE_DB_USERNAME=
PTITONE_DB_PASSWORD=

# --- Profile `distributed` only: the four nodes -----------------------------
# MASTER holds the catalog and DanhBaNguoiDung. It is also the default node:
# login must read the directory there before it knows the user's campus.
# Each site has its own login — they are different machines, kept by
# different people. Do not assume one shared password.
PTITONE_MASTER_URL=
PTITONE_MASTER_USERNAME=
PTITONE_MASTER_PASSWORD=
PTITONE_HCM_URL=
PTITONE_HCM_USERNAME=
PTITONE_HCM_PASSWORD=
PTITONE_HN_URL=
PTITONE_HN_USERNAME=
PTITONE_HN_PASSWORD=
PTITONE_DN_URL=
PTITONE_DN_USERNAME=
PTITONE_DN_PASSWORD=
# Max connections PER node; four pools multiply. Default 5.
PTITONE_SITE_POOL_SIZE=

# Future CENTRAL profile defaults migration to false. Enable only deliberately.
PTITONE_MIGRATE_ON_START=
PTITONE_MIGRATION_USERNAME=
PTITONE_MIGRATION_PASSWORD=

# Auth: base64 of >= 32 random bytes. Generate once per machine, never commit:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Required by the central profile.
PTITONE_JWT_SECRET=
# HMAC key for 6-digit codes (email verification, password reset). Same format
# as the JWT secret but a DIFFERENT value. Required by the central profile.
PTITONE_OTP_SECRET=
# true only when served over HTTPS.
PTITONE_COOKIE_SECURE=

# Outgoing mail via Brevo: activation codes, email verification, password reset.
# Blank FROM, or neither API key nor SMTP host, turns mail off; those features
# then answer 503 MAIL_DISABLED. Free plan: 300 mails/day.
#
# FROM must be a sender verified in Brevo (Settings > Senders, Domains &
# Dedicated IPs > Senders). A Gmail address works; Brevo rewrites the sending
# domain since you do not own gmail.com.
PTITONE_MAIL_FROM=
PTITONE_MAIL_FROM_NAME=PTIT One

# Option A (recommended): Brevo HTTP API. Key from SMTP & API > API Keys,
# starts with xkeysib-. When set, the SMTP settings below are ignored.
PTITONE_BREVO_API_KEY=

# Option B: SMTP relay. Key from SMTP & API > SMTP, starts with xsmtpsib-
# (an xkeysib- API key does NOT work here). Username is the SMTP login shown
# there, e.g. xxxxxx@smtp-brevo.com, not your Brevo account email.
# Host smtp-relay.brevo.com, port 587.
PTITONE_MAIL_HOST=
PTITONE_MAIL_PORT=587
PTITONE_MAIL_USERNAME=
PTITONE_MAIL_PASSWORD=

# Avatar storage on Cloudinary (profile picture on "Thong tin sinh vien").
# The DB stores only the image URL (SinhVien.AnhDaiDien, migration V8), never
# the bytes: an avatar is not business data, and Phase 2 replicates that table
# so binary columns would bloat every snapshot for nothing.
#
# Blank CLOUD_NAME turns upload off; the screen then shows initials instead and
# an upload attempt answers 503. Credentials: Cloudinary dashboard > Settings >
# API Keys. Keep API_SECRET server-side only — never ship it to the frontend.
PTITONE_CLOUDINARY_CLOUD_NAME=
PTITONE_CLOUDINARY_API_KEY=
PTITONE_CLOUDINARY_API_SECRET=
# Folder inside the Cloudinary account; keeps demo uploads separate from others.
PTITONE_CLOUDINARY_FOLDER=ptitone/avatar
