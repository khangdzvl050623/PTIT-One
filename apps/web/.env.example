# apps/web — sao thanh .env.local roi sua. File .env.local KHONG commit.

# mock = du lieu gia, dung UI khong can backend (mac dinh).
# api  = goi API that o apps/api; can SQL Server + API dang chay.
#
# Mot co duy nhat cho CA app. Co y khong tach theo feature: nua that nua gia
# thi man hinh trong nhu chay duoc ma so lieu khong thuoc ve ai.
VITE_API_MODE=mock
