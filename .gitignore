# ---- Bí mật: KHÔNG BAO GIỜ commit ----
.env
.env.*
!.env.example
**/application-local.yml
**/application-secret.yml
*.pfx
*.key
secrets/

# ---- Backup CSDL: để trên Drive chung, không đưa vào git ----
*.bak
*.trn
*.mdf
*.ldf
*.ndf

# ---- Output bang chung: sinh lai duoc, khong commit ----
bang-chung/

# ---- Java / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- Node / Frontend ----
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- IDE ----
.idea/
*.iml
# Loai NOI DUNG .vscode/, khong loai chinh thu muc — neu loai ca thu muc thi
# dong "!" ben duoi vo hieu: git khong the giu lai file nam trong thu muc
# da bi loai. Giu extensions.json de VS Code tu goi y extension cho ca nhom,
# va launch.json de F5 chay API voi apps/api/.env (file nay khong chua bi mat).
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
*.suo
*.user
.vs/

# ---- Hệ điều hành ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Tạm ----
*.log
*.tmp
tmp/

# ---- CodeGraph: index cục bộ từng máy, không commit ----
.codegraph/

# Cau hinh cuc bo cua tung may: ten server, tai khoan SQL cua cac site.
# config.example.psd1 moi la ban mau duoc commit.
config.local.psd1
**/config.local.psd1
